<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>uk.gov.study</groupId>
  <artifactId>land-registry-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>land-registry-api</name>
  <description>API de consulta ao registro de imóveis — projeto de estudo</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!--
      ARMADILHA DO BOOT 4: a auto-configuração do Flyway saiu do
      spring-boot-autoconfigure e foi para o módulo dedicado spring-boot-flyway.
      Declarar apenas org.flywaydb:flyway-core (que era suficiente no Boot 3)
      põe o Flyway no classpath sem ninguém para acioná-lo: a aplicação sobe,
      o build fica verde e NENHUMA migração roda.

      spring-boot-starter-flyway traz o autoconfig e também o
      spring-boot-starter-jdbc, por isso este último não é declarado acima.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Desde o Flyway 10, o suporte a cada banco vive num artefato separado. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x renomeou TODOS os módulos com o prefixo "testcontainers-".
      O que na linha 1.x era org.testcontainers:postgresql agora é
      org.testcontainers:testcontainers-postgresql. Os nomes antigos pararam na
      1.21.4 e não existem na 2.x — copiar um pom de tutorial de Boot 3 aqui
      quebra a resolução de dependências.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Convenção do Maven: surefire roda *Test (unitários, na fase `test`) e
        failsafe roda *IT (integração, na fase `verify`). Sem declarar o failsafe,
        as classes *IT COMPILAM mas NUNCA EXECUTAM, e o build fica verde sem ter
        testado nada. Por isso `make api-test` chama `verify`, não `test`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
