<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>uk.gov.study</groupId>
  <artifactId>land-registry-api</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>land-registry-api</name>
  <description>Land register lookup API — study project</description>

  <properties>
    <java.version>25</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- springdoc 3.x is the line for Spring Boot 4; 2.x is for Boot 3. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.1</version>
    </dependency>

    <!--
      BOOT 4 PITFALL: Flyway auto-configuration moved out of
      spring-boot-autoconfigure into the dedicated spring-boot-flyway module.
      Declaring only org.flywaydb:flyway-core (enough on Boot 3) puts Flyway on
      the classpath with nothing to trigger it: the app starts, the build is
      green and NO migration runs.

      spring-boot-starter-flyway brings the auto-configuration and also
      spring-boot-starter-jdbc, which is why the latter is not declared above.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Since Flyway 10, support for each database lives in its own artifact. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      BOOT 4 PITFALL: @WebMvcTest moved out of spring-boot-test-autoconfigure
      into its own spring-boot-webmvc-test module, with a package change.
      spring-boot-starter-test alone no longer brings it.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Testcontainers 2.x renamed ALL modules with a "testcontainers-" prefix.
      What was org.testcontainers:postgresql in 1.x is now
      org.testcontainers:testcontainers-postgresql. The old names stopped at
      1.21.4 and do not exist in 2.x, so copying a Boot 3 tutorial pom here
      breaks dependency resolution.
    -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>

      <!--
        Maven convention: surefire runs *Test (unit, in the `test` phase) and
        failsafe runs *IT (integration, in the `verify` phase). Without declaring
        failsafe, *IT classes COMPILE but NEVER RUN, and the build stays green
        without having tested anything. That is why `make api-test` calls
        `verify`, not `test`.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
