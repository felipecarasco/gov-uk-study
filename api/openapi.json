{
    "openapi": "3.1.0",
    "info": {
        "title": "Land Registry API",
        "description": "API de consulta ao registro de im\u00f3veis. Projeto de estudo \u2014 os dados s\u00e3o fict\u00edcios e n\u00e3o representam im\u00f3veis reais.",
        "license": {
            "name": "MIT"
        },
        "version": "v1"
    },
    "servers": [
        {
            "url": "/",
            "description": "Este servidor"
        }
    ],
    "paths": {
        "/api/v1/titles/{titleNumber}": {
            "get": {
                "tags": [
                    "title-controller"
                ],
                "operationId": "get",
                "parameters": [
                    {
                        "name": "titleNumber",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "*/*": {
                                "schema": {
                                    "$ref": "#/components/schemas/TitleDetail"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Address": {
                "type": "object",
                "properties": {
                    "line1": {
                        "type": "string"
                    },
                    "line2": {
                        "type": "string"
                    },
                    "town": {
                        "type": "string"
                    },
                    "postcode": {
                        "type": "string"
                    }
                }
            },
            "Charge": {
                "type": "object",
                "properties": {
                    "lender": {
                        "type": "string"
                    },
                    "chargeDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "amountPence": {
                        "type": "integer",
                        "format": "int64"
                    }
                }
            },
            "Proprietor": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "address": {
                        "type": "string"
                    }
                }
            },
            "TitleDetail": {
                "type": "object",
                "properties": {
                    "titleNumber": {
                        "type": "string"
                    },
                    "tenure": {
                        "type": "string",
                        "enum": [
                            "FREEHOLD",
                            "LEASEHOLD"
                        ]
                    },
                    "classOfTitle": {
                        "type": "string"
                    },
                    "address": {
                        "$ref": "#/components/schemas/Address"
                    },
                    "pricePaidPence": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "pricePaidDate": {
                        "type": "string",
                        "format": "date"
                    },
                    "proprietors": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Proprietor"
                        }
                    },
                    "charges": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Charge"
                        }
                    }
                }
            }
        }
    }
}
